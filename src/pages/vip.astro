---
import Base from '../layouts/Base.astro';
import { business, packages } from '../data/site.js';

// Make the phone number tappable wherever it appears in package notes
const linkPhone = (text) =>
  text.replaceAll(
    business.phone,
    `<a href="${business.phoneHref}" style="color:var(--gold);">${business.phone}</a>`
  );
---

<Base
  title="VIP Packages & Bottle Service | Just Enuff Cabaret"
  description="VIP packages at Just Enuff Cabaret, Rockford IL: seating overlooking the stage, bottle service, birthday & bachelor party packages. Call (815) 399-4600."
>
  <div class="page-hero">
    <span class="eyebrow">VIP Experience</span>
    <h1 class="page-title">VIP Packages &amp; <em>Reservations</em></h1>
    <div class="rule"></div>
    <p class="lead">
      From date nights to bachelor parties: reserved seating, premium bottles, dedicated
      service, and unforgettable memories. Call
      <a href={business.phoneHref} style="color:var(--gold);">{business.phone}</a> for reservations.
    </p>
  </div>

  <section>
    <div class="inner">
      <div class="inner-sm" style="padding:0 0 2.5rem;">
        <p class="lead">
          Every package below includes premium seating in our VIP section overlooking the main
          stage and a waived cover charge for your group, so nobody in your party pays at the
          door. Packages are the easiest way to run a bachelor party, birthday, or any group
          night out: you reserve once, your table is waiting when you arrive, and a dedicated
          cocktail server handles the rest. Pair any package with a bottle from our
          <a href="/menu" style="color:var(--gold);"> bottle service menu</a>, and meet the
          <a href="/dancers" style="color:var(--gold);"> entertainers</a> who perform seven nights
          a week. Weekend VIP seating fills up fast, so call a few days ahead.
        </p>
      </div>
      <div class="grid-2">
        {packages.map((p) => (
          <div class={`card pkg ${p.featured ? 'featured' : ''}`}>
            {p.featured && <div class="badge">Most Popular</div>}
            <div>
              <div class="pkg-tier">{p.tier}</div>
              <div class="pkg-name">{p.name}</div>
            </div>
            <div class="pkg-price">{p.price} <small>{p.unit}</small></div>
            <ul>{p.perks.map((perk) => <li>{perk}</li>)}</ul>
            <div class="pkg-note" set:html={linkPhone(p.note)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="inner-sm">
      <h2>How to Reserve</h2>
      <p style="max-width:620px;margin:0 auto 1.6rem;">
        Call <a href={business.phoneHref} style="color:var(--gold);">{business.phone}</a> or email
        <a href={`mailto:${business.email}`} style="color:var(--gold);"> {business.email}</a> with your
        preferred date, party size, and package. Weekend VIP seating fills up fast, so book a few days ahead.
      </p>
      <a class="btn btn-red" href={business.phoneHref}>Call to Reserve</a>
      <a class="btn btn-gold" href={`mailto:${business.email}?subject=VIP%20Reservation%20Request`} style="margin-left:0.8rem;">Email Us</a>
    </div>
  </section>

  <section>
    <div class="inner-sm" style="text-align:center;">
      <span class="eyebrow">Add-Ons</span>
      <h2 class="section-title">Make It a <em>Full Night</em></h2>
      <div class="rule"></div>
      <p class="lead">
        Pair your package with premium bottle service from our menu: champagne, rosé,
        top-shelf tequila, and more.
      </p>
      <div class="hero-btns" style="margin-top:2rem;">
        <a class="btn btn-gold" href="/menu">View Bottle &amp; Food Menu</a>
      </div>
    </div>
  </section>
</Base>
