---
import Base from '../layouts/Base.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { business, dancers } from '../data/site.js';
---

<Base
  title="Dancers & Entertainers | Just Enuff Cabaret, Rockford IL"
  description={`Meet the entertainers of Just Enuff Cabaret, Rockford IL's premier strip club. Professional dancers performing 7 nights a week at 1609 S Alpine Rd.`}
>
  <div class="page-hero">
    <h1 class="page-title">Meet the <em>Entertainers</em></h1>
    <div class="rule"></div>
    <p class="lead">
      Our rotating roster of professional entertainers performs seven nights a week.
    </p>
    <p class="lead">
      The lineup changes nightly, so who is on stage depends on when you visit. Reserve a
      <a href="/vip" style="color:var(--gold);">VIP package</a> for premium seating overlooking
      the stage and a dedicated cocktail server, pair it with
      <a href="/menu" style="color:var(--gold);">bottle service</a>, or just walk in any night
      from 4 PM to 2 AM. Interested in joining the roster? We audition entertainers year-round
      on our <a href="/apply" style="color:var(--gold);">application page</a>.
    </p>
  </div>

  <section>
    <div class="inner">
      <div class="grid-3">
        {dancers.map((d, i) => (
          <div class="card" style="padding:0.9rem;">
            <PhotoSlot
              image={d.image}
              alt={`${d.name}, dancer at Just Enuff Cabaret gentlemen's club in Rockford, Illinois`}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
            <div class="card-name">{d.name}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="inner-sm">
      <h2>Want the Full VIP Treatment?</h2>
      <p>Our Red Heel and Cabaret Royale packages include entertainer meet &amp; greets and private time.</p>
      <a class="btn btn-red" href="/vip">View VIP Packages</a>
      <a class="btn btn-gold" href={business.phoneHref} style="margin-left:0.8rem;">Call {business.phone}</a>
    </div>
  </section>
</Base>
